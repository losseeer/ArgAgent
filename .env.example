# 主 LLM（推荐填；不填则走本地 Ollama）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash    # 模型名唯一出处（Q20 已决）：只写 API 名，不写营销代际

# 本地回退 LLM（不填则降级兜底模板）
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_HOST=http://host.docker.internal:11434

# Web 检索（不填则降级 DuckDuckGo）
TAVILY_API_KEY=

# 内容审核二次判（不填则只走本地模式表，并在 UI 显式标"审核降级"，§6.13 / N8）
MODERATION_API_KEY=

# 端口（默认即可）
BACKEND_PORT=8010
FRONTEND_PORT=3005
CHROMA_PORT=8011
