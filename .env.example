# 主 LLM（推荐填；不填则走本地 Ollama）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_MODEL 是模型名的唯一出处（换模型只改这一行；只写 API 名，不写营销代际）。
# 注释一律单独成行：docker compose 的 env_file 不剥行尾注释，写在值后面会被当成值的一部分。
DEEPSEEK_MODEL=deepseek-flash

# 本地回退 LLM（不填则降级兜底模板）
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_HOST=http://host.docker.internal:11434

# Web 检索（不填则降级 DuckDuckGo）
TAVILY_API_KEY=

# 内容审核二次判（不填则只走本地模式表，并在 UI 显式标"审核降级"，§6.13 / N8）
MODERATION_API_KEY=

# 端口（默认即可）
BACKEND_PORT=8010
FRONTEND_PORT=3005
CHROMA_PORT=8011
